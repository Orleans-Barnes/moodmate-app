{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["src/*"],
      "@react-native-community/slider": ["node_modules/@react-native-community/slider/typings/index.d.ts"],
      "expo-image-picker": ["node_modules/expo-image-picker/build/ImagePicker.d.ts"]
    },
    "ignoreDeprecations": "5.0"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
