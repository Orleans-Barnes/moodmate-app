# Copy to .env (or export these directly) before running locally.
# Never commit a real .env file.

PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/moodmate
DB_USERNAME=moodmate
DB_PASSWORD=moodmate

# 32+ char random secret. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-real-random-32-plus-char-secret
JWT_EXPIRATION_MINUTES=1440

# Paystack TEST mode keys (https://dashboard.paystack.com/#/settings/developers)
# Must start with sk_test_ / pk_test_ - never put a live (sk_live_) key here.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=moodmate://payment-callback

# Feature 18 (End-to-End Verification) - the four blocks below were used by application.yml in
# moodmate-auth/moodmate-ai but missing from this file. All have safe empty/default fallbacks
# (see each service's application.yml), so every service still starts without them - only the one
# specific feature each backs will fail (with a clear error, not a crash) until it's set. Leaving
# them commented out is fine for a first run.

# moodmate-ai - primary model for AI chat (/api/ai/chat) and the insights narrative. Without it,
# those specific endpoints return a clear 503 instead of a confusing error; nothing else is affected.
# GROQ_API_KEY=

# moodmate-ai - secondary/fallback model, used automatically if the primary (Groq) call fails, and
# selectable by Pro users once dual-model routing is built. Get a key at aistudio.google.com/apikey.
# GEMINI_API_KEY=

# moodmate-auth - a Gmail address + 16-character Gmail App Password (with spaces removed, NOT
# your normal Gmail password - see https://myaccount.google.com/apppasswords). Required only for
# forgot-password/reset-password to actually send an email; auth still starts and everything else
# works fine without it.
# MAIL_USERNAME=
# MAIL_PASSWORD=

# moodmate-auth - optional demo/seed data for local development. SEED_DEMO_ACCOUNTS=true seeds a
# demo admin account on startup using SEED_ADMIN_PASSWORD; leave both unset/false for a clean DB.
# SEED_DEMO_ACCOUNTS=false
# SEED_ADMIN_PASSWORD=
