<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.moodmate</groupId>
        <artifactId>moodmate-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>moodmate-gateway</artifactId>
    <name>MoodMate — Gateway</name>
    <description>Spring Cloud Gateway — JWT validation, routing, CORS</description>

    <dependencies>
        <!-- Renamed from spring-cloud-starter-gateway in the 2025.0 release train (the old name
             still resolves but is deprecated and logs a warning on every startup) - see
             https://github.com/spring-cloud/spring-cloud-release/wiki/Spring-Cloud-2025.0-Release-Notes.
             This is the reactive/WebFlux-stack gateway (matches this module's reactive
             JwtAuthFilter/ServerWebExchange code), not the new WebMVC-stack sibling. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Feature 16 (Observability) - Part 5, Prometheus Integration. Version managed by the
             spring-boot-dependencies BOM (imported via moodmate-parent), same as every other
             unversioned dependency in this file - no new version property needed. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Added for Feature 5 (Rate Limiting) - no tests existed in this module before;
             brings in JUnit 5 + Reactor's reactive test support + MockServerWebExchange, used by
             RateLimitFilterTest. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
